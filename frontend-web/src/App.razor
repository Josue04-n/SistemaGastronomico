<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div class="container py-5 text-center">
                        <div class="card shadow-sm p-4 mx-auto" style="max-width: 500px;">
                            <h3 class="text-danger mb-3">Acceso Restringido</h3>
                            <p class="text-muted">Debe iniciar sesión como dueño de local o administrador para acceder a este módulo.</p>
                            <a href="login" class="btn btn-primary mt-2">Ir a Iniciar Sesión</a>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
