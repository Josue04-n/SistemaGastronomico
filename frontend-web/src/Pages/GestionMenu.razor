@page "/menu"
@attribute [Authorize]
@inject LocalService LocalService
@inject MenuService MenuService
@inject NavigationManager Navigation

<PageTitle>Menú y Actualización Rápida - Sistema Gastronómico UTA</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-egg-fried text-warning me-2"></i>Gestión de Menú y Ofertas
            </h2>
            <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1">
                <i class="bi bi-lightning-charge-fill me-1"></i> Actualización Rápida
            </span>
        </div>
        <p class="text-muted small mt-1 mb-0">
            Modifica precios, disponibilidad o destaca el menú del día directamente sobre los componentes visuales en un solo clic.
        </p>
    </div>

    @if (localActual != null)
    {
        <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3" @onclick="AbrirModalCrear">
            <i class="bi bi-plus-circle-fill"></i> Agregar Plato / Combo
        </button>
    }
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted fw-semibold">Cargando menú...</p>
    </div>
}
else if (localActual == null)
{
    <div class="alert alert-warning p-4 rounded-4 shadow-sm border-0" role="alert">
        <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Primero registra tu local</h5>
        <p>Para gestionar tu oferta diaria de comidas, primero debes registrar los datos de tu establecimiento en la sección Mi Local.</p>
        <a href="local" class="btn btn-warning btn-sm fw-semibold">Ir a Mi Local</a>
    </div>
}
else
{
    <!-- Barra de Filtros por Categoría -->
    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center bg-white p-3 rounded-4 shadow-sm border">
        <span class="text-muted small fw-bold me-2"><i class="bi bi-funnel-fill text-primary"></i> Categoría:</span>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(filtroCategoria == null ? "btn-primary" : "btn-light text-secondary")"
                @onclick="() => FiltrarPorCategoria(null)">
            Todos (@platos.Count)
        </button>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(filtroCategoria == CategoriaPlatoModel.Almuerzo ? "btn-primary" : "btn-light text-secondary")"
                @onclick="() => FiltrarPorCategoria(CategoriaPlatoModel.Almuerzo)">
            🍲 Almuerzos
        </button>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(filtroCategoria == CategoriaPlatoModel.ComidaRapida ? "btn-primary" : "btn-light text-secondary")"
                @onclick="() => FiltrarPorCategoria(CategoriaPlatoModel.ComidaRapida)">
            🍔 Comida Rápida
        </button>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(filtroCategoria == CategoriaPlatoModel.Combo ? "btn-primary" : "btn-light text-secondary")"
                @onclick="() => FiltrarPorCategoria(CategoriaPlatoModel.Combo)">
            🍕 Combos
        </button>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(filtroCategoria == CategoriaPlatoModel.Desayuno ? "btn-primary" : "btn-light text-secondary")"
                @onclick="() => FiltrarPorCategoria(CategoriaPlatoModel.Desayuno)">
            ☕ Desayunos
        </button>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(filtroCategoria == CategoriaPlatoModel.Bebida ? "btn-primary" : "btn-light text-secondary")"
                @onclick="() => FiltrarPorCategoria(CategoriaPlatoModel.Bebida)">
            🥤 Bebidas
        </button>
    </div>

    @if (platosFiltrados.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center p-5 rounded-4 bg-white">
            <div class="d-inline-flex p-4 rounded-circle mx-auto mb-2" style="background-color: var(--uta-red-subtle);">
                <i class="bi bi-inbox-fill text-primary" style="font-size: 2.5rem;"></i>
            </div>
            <h5 class="fw-bold mt-2">No hay platos registrados en esta categoría</h5>
            <p class="text-muted small mx-auto" style="max-width: 400px;">
                Haz clic en el botón superior para agregar un nuevo plato, combo o menú del día.
            </p>
        </div>
    }
    else
    {
        <!-- Grid de Componentes Visuales Interactivos -->
        <div class="row g-4">
            @foreach (var plato in platosFiltrados)
            {
                <div class="col-md-6 col-xl-4" @key="plato.Id">
                    <div class="plato-card h-100 position-relative d-flex flex-column @(plato.EsPlatoDelDia ? "plato-del-dia" : "") @(plato.EstaDisponible ? "" : "opacity-75 bg-light")">
                        
                        @if (plato.EsPlatoDelDia)
                        {
                            <span class="position-absolute top-0 start-0 badge badge-plato-dia m-3 rounded-pill px-3 py-2 small">
                                <i class="bi bi-fire me-1"></i> Plato del Día
                            </span>
                        }

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start @(plato.EsPlatoDelDia ? "mt-4" : "")">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">@plato.Nombre</h5>
                                    <span class="badge bg-light text-secondary border small">@plato.Categoria</span>
                                </div>
                                <div class="text-end">
                                    <span class="fs-4 fw-bold text-success">
                                        $@plato.Precio.ToString("F2")
                                    </span>
                                </div>
                            </div>

                            <p class="text-muted small mt-3 flex-grow-1">
                                @(string.IsNullOrWhiteSpace(plato.Descripcion) ? "Sin descripción detallada." : plato.Descripcion)
                            </p>

                            <!-- Controles de Actualización Rápida (1 Clic) -->
                            <div class="border-top pt-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-semibold text-secondary">
                                        <i class="bi bi-circle-fill me-1 @(plato.EstaDisponible ? "text-success" : "text-danger")"></i> Estado:
                                    </span>
                                    <button class="btn btn-sm @(plato.EstaDisponible ? "btn-success" : "btn-secondary") px-3 py-1 rounded-pill fw-semibold shadow-sm"
                                            @onclick="() => ToggleDisponible(plato)"
                                            title="Cambiar disponibilidad con 1 clic">
                                        <i class="bi @(plato.EstaDisponible ? "bi-check2-circle" : "bi-dash-circle") me-1"></i>
                                        @(plato.EstaDisponible ? "Disponible" : "Agotado")
                                    </button>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="small fw-semibold text-secondary">
                                        <i class="bi bi-star-fill me-1 text-warning"></i> Menú del Día:
                                    </span>
                                    <button class="btn btn-sm @(plato.EsPlatoDelDia ? "btn-warning text-dark fw-bold" : "btn-outline-secondary") px-3 py-1 rounded-pill"
                                            @onclick="() => TogglePlatoDelDia(plato)"
                                            title="Destacar como especial del día">
                                        <i class="bi @(plato.EsPlatoDelDia ? "bi-star-fill" : "bi-star") me-1"></i>
                                        @(plato.EsPlatoDelDia ? "Destacado Hoy" : "Marcar Hoy")
                                    </button>
                                </div>

                                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                    <button class="btn btn-outline-primary btn-sm px-3" @onclick="() => AbrirModalEditar(plato)">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm px-2" @onclick="() => EliminarPlato(plato)" title="Eliminar">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- Modal para Crear / Editar Plato o Combo -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.6);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white py-3 px-4">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(esEdicion ? "bi-pencil-fill" : "bi-plus-circle-fill") me-2"></i>
                        @(esEdicion ? "Modificar Plato / Combo" : "Nuevo Plato o Combo")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <EditForm Model="modeloFormulario" OnValidSubmit="GuardarPlato">
                    <DataAnnotationsValidator />

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del Plato / Oferta</label>
                            <InputText class="form-control" @bind-Value="modeloFormulario.Nombre" placeholder="Ej: Almuerzo con arroz y huevo frito, Combo Pizza Mediana + Cola" />
                            <ValidationMessage For="() => modeloFormulario.Nombre" class="text-danger small" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Categoría</label>
                                <InputSelect class="form-select" @bind-Value="modeloFormulario.Categoria">
                                    <option value="@CategoriaPlatoModel.Almuerzo">Almuerzo</option>
                                    <option value="@CategoriaPlatoModel.Desayuno">Desayuno</option>
                                    <option value="@CategoriaPlatoModel.PlatoCarta">Plato a la Carta</option>
                                    <option value="@CategoriaPlatoModel.ComidaRapida">Comida Rápida</option>
                                    <option value="@CategoriaPlatoModel.Combo">Combo</option>
                                    <option value="@CategoriaPlatoModel.Bebida">Bebida</option>
                                    <option value="@CategoriaPlatoModel.Snack">Snack</option>
                                    <option value="@CategoriaPlatoModel.Postre">Postre</option>
                                    <option value="@CategoriaPlatoModel.Otro">Otro</option>
                                </InputSelect>
                            </div>

                            <div class="col-6">
                                <label class="form-label fw-semibold">Precio ($ USD)</label>
                                <InputNumber class="form-control" @bind-Value="modeloFormulario.Precio" step="0.05" />
                                <ValidationMessage For="() => modeloFormulario.Precio" class="text-danger small" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción (Componentes del plato)</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="modeloFormulario.Descripcion" placeholder="Ej: Sopa de pollo + arroz con menestra y carne asada + jugo + postre." />
                        </div>

                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox class="form-check-input" @bind-Value="modeloFormulario.EstaDisponible" id="checkDisp" />
                                <label class="form-check-label fw-semibold ms-2" for="checkDisp">Disponible para servir ahora</label>
                            </div>

                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" @bind-Value="modeloFormulario.EsPlatoDelDia" id="checkPlatoDia" />
                                <label class="form-check-label fw-semibold ms-2 text-warning-emphasis" for="checkPlatoDia">Destacar como Plato del Día</label>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light px-4 py-3">
                        <button type="button" class="btn btn-secondary px-3" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4 shadow" disabled="@guardandoPlato">
                            @if (guardandoPlato)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1"></i>
                                <span>Guardar Plato</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private bool guardandoPlato = false;
    private bool mostrarModal = false;
    private bool esEdicion = false;

    private LocalModel? localActual;
    private List<PlatoModel> platos = new();
    private CategoriaPlatoModel? filtroCategoria;

    private CreateOrUpdatePlatoModel modeloFormulario = new();

    private List<PlatoModel> platosFiltrados => filtroCategoria.HasValue
        ? platos.Where(p => p.Categoria == filtroCategoria.Value).ToList()
        : platos;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        var locales = await LocalService.GetMisLocalesAsync();
        localActual = locales.FirstOrDefault();

        if (localActual != null)
        {
            platos = await MenuService.GetPlatosAsync(localActual.Id);
        }

        cargando = false;
    }

    private void FiltrarPorCategoria(CategoriaPlatoModel? cat)
    {
        filtroCategoria = cat;
    }

    private async Task ToggleDisponible(PlatoModel plato)
    {
        // Actualización rápida reactiva: cambio inmediato en interfaz y backend
        plato.EstaDisponible = !plato.EstaDisponible;
        var exito = await MenuService.ToggleDisponibleAsync(plato.Id);
        if (!exito)
        {
            plato.EstaDisponible = !plato.EstaDisponible; // Revertir si falla la llamada
        }
    }

    private async Task TogglePlatoDelDia(PlatoModel plato)
    {
        // Actualización rápida reactiva: cambio inmediato en interfaz y backend
        plato.EsPlatoDelDia = !plato.EsPlatoDelDia;
        var exito = await MenuService.TogglePlatoDelDiaAsync(plato.Id);
        if (!exito)
        {
            plato.EsPlatoDelDia = !plato.EsPlatoDelDia;
        }
    }

    private void AbrirModalCrear()
    {
        if (localActual == null) return;
        esEdicion = false;
        modeloFormulario = new CreateOrUpdatePlatoModel
        {
            LocalId = localActual.Id,
            Precio = 2.50m,
            EstaDisponible = true,
            EsPlatoDelDia = false
        };
        mostrarModal = true;
    }

    private void AbrirModalEditar(PlatoModel plato)
    {
        esEdicion = true;
        modeloFormulario = new CreateOrUpdatePlatoModel
        {
            Id = plato.Id,
            LocalId = plato.LocalId,
            Nombre = plato.Nombre,
            Descripcion = plato.Descripcion,
            Precio = plato.Precio,
            ImagenUrl = plato.ImagenUrl,
            Categoria = plato.Categoria,
            EstaDisponible = plato.EstaDisponible,
            EsPlatoDelDia = plato.EsPlatoDelDia
        };
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarPlato()
    {
        guardandoPlato = true;

        if (esEdicion)
        {
            var (exito, actualizado, _) = await MenuService.UpdateAsync(modeloFormulario);
            if (exito && actualizado != null)
            {
                var index = platos.FindIndex(p => p.Id == actualizado.Id);
                if (index >= 0)
                {
                    platos[index] = actualizado;
                }
                mostrarModal = false;
            }
        }
        else
        {
            var (exito, creado, _) = await MenuService.CreateAsync(modeloFormulario);
            if (exito && creado != null)
            {
                platos.Insert(0, creado);
                mostrarModal = false;
            }
        }

        guardandoPlato = false;
    }

    private async Task EliminarPlato(PlatoModel plato)
    {
        var exito = await MenuService.DeleteAsync(plato.Id);
        if (exito)
        {
            platos.Remove(plato);
        }
    }
}
