@page "/"
@attribute [Authorize]
@inject LocalService LocalService
@inject EstadisticasService EstadisticasService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard - Sistema Gastronómico UTA</PageTitle>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted fw-semibold">Cargando métricas del panel...</p>
    </div>
}
else if (miLocal == null)
{
    <div class="card shadow-sm border text-center p-5 my-4 bg-white rounded-4">
        <div class="mb-3">
            <div class="d-inline-flex p-4 rounded-circle bg-primary-subtle text-primary">
                <i class="bi bi-shop text-primary" style="font-size: 3.5rem;"></i>
            </div>
        </div>
        <h3 class="fw-bold text-dark">¡Bienvenido a la Plataforma Gastronómica UTA!</h3>
        <p class="text-muted mx-auto fs-6" style="max-width: 550px;">
            Aún no tienes un local registrado. Configura los datos de tu comedor o cafetería para comenzar a publicar tus menús universitarios y promociones para los estudiantes de la UTA.
        </p>
        <div class="mt-3">
            <a href="local" class="btn btn-primary btn-lg px-4 shadow-sm">
                <i class="bi bi-plus-circle-fill me-2"></i> Registrar Mi Local
            </a>
        </div>
    </div>
}
else
{
    <!-- Encabezado del Local -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-4 bg-white rounded-4 shadow-sm border">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="fw-bold text-dark mb-0">@miLocal.Nombre</h2>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small fw-bold">
                    <i class="bi bi-geo-alt-fill me-1"></i> @miLocal.CampusCercano
                </span>
            </div>
            <p class="text-muted small mb-0">
                <i class="bi bi-pin-map me-1 text-primary"></i> @miLocal.Direccion 
                @(string.IsNullOrWhiteSpace(miLocal.Referencia) ? "" : $"({miLocal.Referencia})")
            </p>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-sm-block">
                <span class="d-block small text-muted fw-semibold">Disponibilidad en App</span>
                <span class="small fw-bold @(miLocal.EstaAbierto ? "text-success" : "text-secondary")">
                    @(miLocal.EstaAbierto ? "Abierto para Estudiantes" : "Cerrado Temporalmente")
                </span>
            </div>
            <button class="btn @(miLocal.EstaAbierto ? "btn-success" : "btn-secondary") px-3 py-2 d-flex align-items-center gap-2 shadow-sm rounded-3"
                    @onclick="CambiarEstadoApertura"
                    disabled="@cambiandoEstado">
                @if (cambiandoEstado)
                {
                    <span class="spinner-border spinner-border-sm text-white"></span>
                }
                else
                {
                    <i class="bi @(miLocal.EstaAbierto ? "bi-door-open-fill" : "bi-door-closed-fill") fs-5 text-white"></i>
                }
                <span class="fw-semibold text-white">@(miLocal.EstaAbierto ? "Abierto" : "Cerrado")</span>
            </button>
        </div>
    </div>

    <!-- Tarjetas KPI: Estadísticas Básicas -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card h-100 p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Visitas Estudiantiles</span>
                        <h2 class="fw-bold my-1 text-dark">@(estadisticas?.TotalVisitas ?? 0)</h2>
                        <span class="text-muted small"><i class="bi bi-cursor-fill me-1 text-primary"></i> Clics en tu local</span>
                    </div>
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card h-100 p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Menús Guardados</span>
                        <h2 class="fw-bold my-1 text-dark">@(estadisticas?.TotalMenusGuardados ?? 0)</h2>
                        <span class="text-muted small"><i class="bi bi-bookmark-star-fill me-1 text-primary"></i> En favoritos</span>
                    </div>
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-bookmark-heart-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card h-100 p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Platos Disponibles</span>
                        <h2 class="fw-bold my-1 text-dark">
                            @(estadisticas?.PlatosDisponibles ?? 0) <small class="text-muted fs-6 fw-normal">/ @(estadisticas?.TotalPlatos ?? 0)</small>
                        </h2>
                        <span class="text-muted small"><i class="bi bi-check2-circle me-1 text-primary"></i> Servidos hoy</span>
                    </div>
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-egg-fried fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card h-100 p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Calificación UTA</span>
                        <h2 class="fw-bold my-1 text-dark">
                            @(estadisticas?.CalificacionPromedio ?? 0.0) <small class="text-muted fs-6 fw-normal">★</small>
                        </h2>
                        <span class="text-muted small">@(estadisticas?.TotalResenas ?? 0) opiniones</span>
                    </div>
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-star-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos de Acción Rápida -->
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card border shadow-sm h-100 p-4 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Actualización Rápida</h5>
                        <small class="text-muted">Control de oferta inmediata</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Cambia la disponibilidad de almuerzos o activa el plato del día en un solo clic para los estudiantes.
                </p>
                <a href="menu" class="btn btn-outline-primary btn-sm mt-3 w-100 py-2">
                    Gestionar Menú <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border shadow-sm h-100 p-4 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-tags-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Combos y Promociones</h5>
                        <small class="text-muted">Descuentos universitarios</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Publica combos de pizza, almuerzos especiales o promociones de café con pan para la tarde.
                </p>
                <a href="promociones" class="btn btn-outline-primary btn-sm mt-3 w-100 py-2">
                    Ver Promociones <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border shadow-sm h-100 p-4 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Perfil y Geolocalización</h5>
                        <small class="text-muted">Campus y coordenadas</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Mantén actualizadas las coordenadas GPS, horarios y teléfono de contacto para el cálculo de distancia a pie.
                </p>
                <a href="local" class="btn btn-outline-primary btn-sm mt-3 w-100 py-2">
                    Editar Información <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private bool cambiandoEstado = false;
    private LocalModel? miLocal;
    private LocalEstadisticasModel? estadisticas;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        var locales = await LocalService.GetMisLocalesAsync();
        miLocal = locales.FirstOrDefault();

        if (miLocal != null)
        {
            estadisticas = await EstadisticasService.GetEstadisticasAsync(miLocal.Id);
        }

        cargando = false;
    }

    private async Task CambiarEstadoApertura()
    {
        if (miLocal == null) return;

        cambiandoEstado = true;
        var exito = await LocalService.ToggleAperturaAsync(miLocal.Id);
        if (exito)
        {
            miLocal.EstaAbierto = !miLocal.EstaAbierto;
        }
        cambiandoEstado = false;
    }
}
