@page "/local"
@attribute [Authorize]
@inject LocalService LocalService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Mi Local - Sistema Gastronómico UTA</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-shop text-primary me-2"></i>Información de Mi Local
        </h2>
        <p class="text-muted small mb-0">Configura los datos que verán los estudiantes de la UTA al buscar comida</p>
    </div>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <EditForm Model="modelo" OnValidSubmit="GuardarLocal">
                        <DataAnnotationsValidator />

                        <h5 class="fw-bold mb-3 text-secondary">Datos Principales</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Nombre del Establecimiento</label>
                                <InputText class="form-control" @bind-Value="modelo.Nombre" placeholder="Ej: Comedor Doña Carmen" />
                                <ValidationMessage For="() => modelo.Nombre" class="text-danger small" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Categoría Gastronómica</label>
                                <InputSelect class="form-select" @bind-Value="modelo.Categoria">
                                    <option value="@CategoriaLocalModel.Almuerzos">Almuerzos</option>
                                    <option value="@CategoriaLocalModel.ComidaRapida">Comida Rápida</option>
                                    <option value="@CategoriaLocalModel.Cafeteria">Cafetería</option>
                                    <option value="@CategoriaLocalModel.Pizzeria">Pizzería</option>
                                    <option value="@CategoriaLocalModel.Panaderia">Panadería</option>
                                    <option value="@CategoriaLocalModel.Asadero">Asadero</option>
                                    <option value="@CategoriaLocalModel.VegetarianoVegano">Vegetariano / Vegano</option>
                                    <option value="@CategoriaLocalModel.Otro">Otro</option>
                                </InputSelect>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Descripción o Especialidad</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="modelo.Descripcion" placeholder="Ej: Almuerzos ejecutivos completos con sopa, segundo, jugo y postre. Menú económico para universitarios." />
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 mt-4 text-secondary">Ubicación y Campus UTA</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Campus UTA Más Cercano</label>
                                <InputSelect class="form-select" @bind-Value="modelo.CampusCercano">
                                    <option value="@CampusUTAModel.Huachi">Campus Huachi</option>
                                    <option value="@CampusUTAModel.Ingahurco">Campus Ingahurco</option>
                                    <option value="@CampusUTAModel.Querochaca">Campus Querochaca</option>
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Dirección</label>
                                <InputText class="form-control" @bind-Value="modelo.Direccion" placeholder="Av. Los Chasquis y Río Guayllabamba" />
                                <ValidationMessage For="() => modelo.Direccion" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Referencia Universitaria</label>
                                <InputText class="form-control" @bind-Value="modelo.Referencia" placeholder="Ej: Diagonal a la puerta 3 del Campus Huachi, junto a la fotocopiadora" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Latitud GPS</label>
                                <InputNumber class="form-control" @bind-Value="modelo.Latitud" step="0.000001" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Longitud GPS</label>
                                <InputNumber class="form-control" @bind-Value="modelo.Longitud" step="0.000001" />
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 mt-4 text-secondary">Contacto y Horarios</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">WhatsApp para Pedidos</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-whatsapp text-success"></i></span>
                                    <InputText class="form-control" @bind-Value="modelo.WhatsApp" placeholder="0991234567" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Horario de Atención</label>
                                <InputText class="form-control" @bind-Value="modelo.HorarioApertura" placeholder="Ej: Lun - Vie: 07:30 a 17:00" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-floppy me-1"></i>
                                <span>Guardar Cambios</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Guía de Geolocalización</h5>
                <p class="small text-muted mb-2">
                    Las coordenadas ingresadas se utilizarán para calcular automáticamente la distancia a pie para los estudiantes que usen la app móvil o el mapa.
                </p>
                <hr />
                <h6 class="fw-semibold small">Coordenadas de Referencia:</h6>
                <ul class="list-unstyled small text-muted">
                    <li><strong>Campus Huachi:</strong> -1.2687, -78.6254</li>
                    <li><strong>Campus Ingahurco:</strong> -1.2415, -78.6180</li>
                    <li><strong>Campus Querochaca:</strong> -1.3325, -78.6012</li>
                </ul>
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private bool guardando = false;
    private string? mensajeExito;
    private string? mensajeError;

    private CreateOrUpdateLocalModel modelo = new();
    private bool esEdicion = false;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        var locales = await LocalService.GetMisLocalesAsync();
        var local = locales.FirstOrDefault();

        if (local != null)
        {
            esEdicion = true;
            modelo = new CreateOrUpdateLocalModel
            {
                Id = local.Id,
                Nombre = local.Nombre,
                Descripcion = local.Descripcion,
                Direccion = local.Direccion,
                Referencia = local.Referencia,
                CampusCercano = local.CampusCercano,
                Categoria = local.Categoria,
                Latitud = local.Latitud,
                Longitud = local.Longitud,
                TelefonoContacto = local.TelefonoContacto,
                WhatsApp = local.WhatsApp,
                HorarioApertura = local.HorarioApertura,
                LogoUrl = local.LogoUrl,
                PortadaUrl = local.PortadaUrl,
                EstaAbierto = local.EstaAbierto,
                PropietarioId = local.PropietarioId
            };
        }
        else
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null && Guid.TryParse(user.Id, out var uid))
            {
                modelo.PropietarioId = uid;
            }
        }

        cargando = false;
    }

    private async Task GuardarLocal()
    {
        guardando = true;
        mensajeExito = null;
        mensajeError = null;

        if (esEdicion)
        {
            var (exito, _, msg) = await LocalService.UpdateAsync(modelo);
            if (exito)
            {
                mensajeExito = "Los datos de tu local se actualizaron con éxito.";
            }
            else
            {
                mensajeError = msg ?? "Error al actualizar los datos.";
            }
        }
        else
        {
            var (exito, creado, msg) = await LocalService.CreateAsync(modelo);
            if (exito && creado != null)
            {
                esEdicion = true;
                modelo.Id = creado.Id;
                mensajeExito = "¡Tu local ha sido registrado exitosamente!";
            }
            else
            {
                mensajeError = msg ?? "Error al registrar el local.";
            }
        }

        guardando = false;
    }
}
